---
scripts: <script src="assets/js/pulldown.js"></script>
permalink: assets/pagetray/{{ comicPage.name | slugify }}/
base-link: ../../../
tag: "page"
pagination: 
 data: pagedata 
 size: 1
 alias: comicPage 
---
{% set p = pagination %}{% set pn = p.pageNumber %}
{% set comb = comic_data.url.page %}
{% set mathed = 1 + pn %}
<hr class="main splitter rounder dynamicles white bg">

        <main style="margin: auto; background-color: rgba(255, 255, 255, 0);">
            <nav id="behindContent">
		<a href="{{ p.pages[3 - pn].type.bw }}#start"><img id="back3" class="white bg page bgpage dynamicles ani{% if pn < 3 %} off{% endif %}"  src="{{ [comb, p.pages[pn - 3].type.bw] | join }}" alt="back 3"></a>
		<a href="assets/pagetray/{{ pn - 1}}.html#start"><img id="back2" class="white bg page bgpage dynamicles ani{% if pn < 2 %} off{% endif %}"  src="{{ [comb, p.pages[pn - 2].type.bw] | join }}" alt="back 2"></a>
		<a href="assets/pagetray/{{ pn }}.html#start"><img id="back1" class="white bg page bgpage dynamicles ani{% if pn < 1 %} off{% endif %}"  src="{{ [comb, p.pages[pn - 1].type.bw] | join }}" alt="back 1"></a>

		<a href="{{ p.href.next }}#start"><img id="nextpage" class="white bg page bgpage dynamicles ani{% if not p.href.next %} off{% endif %}" alt="next page" src="{{ [comb, p.pages[pn + 1].type.bw] | join }}#start"></a>
            </nav>
            
            <div style="z-index: 2; margin: auto; display: flex; justify-content: center;">
		    <a href="{{ pagination.href.next }}"><img id="currentpage" class="white bg page dynamicles ani" alt="current page" src="{{ comb + comicPage.type.bw }}"></a>
		    <img src="assets/pagetray/{{ comb2[0] }}.png" id="sticker" class="untouchable boo long" alt="sticker layer">
            </div>
        </main>

	<nav id="underpage" class="horizontalList mobile" style="padding:2%; margin-bottom: 3%;">
		<div id="navside" class="horizontalList" style="padding-top: 2px;">
			<a class="local" href="assets/pagetray/.html" style="filter: drop-shadow(-4vw 1.5vw rgba(var(--white), 0.3)); max-width: 120px; margin-left: 10px;">
				<div class="arrow nav clippy white bg icon dynamicles flip" ></div>
			</a>
			<a href="assets/pagetray/3.html" class="arrow nav clippy white bg flip icon dynamicles" ></a>
			<a href="assets/pagetray/5.html" class="arrow nav clippy white bg icon dynamicles"></a>
			<a class="local" href="assets/pagetray/20.html" style="filter: drop-shadow(4vw 1.5vw rgba(var(--white), 0.3)); max-width: 120px; margin-right: 10px;">
				<div class="arrow nav clippy white bg icon dynamicles" ></div>
			</a>
		</div>
		<div id="bookmarkside" class="horizontalList" >
			<a href="comic.html" class="nav icon bookmark ani white bg dynamicles clippy save mobile"></a>
			<a href="comic.html" class="nav icon bookmark ani white bg dynamicles clippy load mobile"></a>
		</div>
	</nav>
    </div>
    <hr class="splitter secondary rounder dynamicles" style="max-width:1040px; width:95%">
	<nav class="flexify center divided" style="font-size: 18px;">
		<span id="pageSelect" class="light grey text" style="display:flex;">
			<select name="versionselect" style="height:25px; align-self:center;text-transform:uppercase;" onchange="document.getElementById('currentpage').src = this.value">
				<option value="assets/pagetray/{{ currentpage }}r.png">ORIGINAL</option>
				<optgroup label="PROGRESS">
					<option value="assets/pagetray/old/{{ currentpage }}s.png">SKETCH</option>
					<option value="assets/pagetray/old/{{ currentpage }}t.png">THUMBNAIL</option>
				</optgroup>
				<optgroup label="OLD">
					<option value="assets/pagetray/50.png">"NO. 42" (12/16/24)</option>
				</optgroup>
			</select>
		</span>
	    <span class="fancyText secondary text">12/17/24, 3:48 PM</span>
	</nav>
	<a href="comic.html" class="grey bg fancyText center flexify main cascade flexify rounder dynamicles hosted" style="text-transform:uppercase; margin-top:10px">
			<span>&#11088;</span><span>&#11088;</span><span>&#11088;</span><span>&#11088;</span><span>&#11088;</span>
	</a>

   		<article class="under" style="padding-top:20px">
		</article>

		<div id="catch-up"></div>
		<div class="flexify not row center hosted" style="padding-top: 20px; padding-bottom:30px;">
			<a class="center" href="comic.html">
				<img src="assets/metacontent/icons/airtalk.svg">
			</a>
			<h1 class="center" style="font-size:35px;">comments:</h1>
		</div>
		<div id="dummythang" style="height:500px;"></div>
				
